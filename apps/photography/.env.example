# Cloudflare R2 bucket the photographs are served from (build-time: getImages()).
CLOUDFLARE_ID=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_BUCKET_HOSTNAME=

# Upstash Redis for the shared per-photo ❤️ tally. Read only by
# pages/api/hearts.ts — the browser never sees these. Connect an Upstash
# store to the Vercel project (Storage tab) and it fills these in; the
# Marketplace integration uses the KV_REST_API_* names instead, which the
# route also accepts. Leave blank to run without a shared tally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
