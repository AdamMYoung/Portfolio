{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "CLOUDFLARE_ID",
        "S3_ACCESS_KEY",
        "S3_SECRET_ACCESS_KEY",
        "S3_BUCKET_NAME",
        "S3_BUCKET_HOSTNAME",
        "ENABLE_EXPERIMENTAL_COREPACK"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
